# ============================================================================
# config.ghostty — Ghostty terminal configuration.
#
# Stowed to ~/.config/ghostty/config.ghostty (single stow target: $HOME).
# The auto/ directory next to this file is generated by ghostty itself
# (auto-detected theme values); it is intentionally NOT stowed.
# ============================================================================

## --- Appearance
# Terminal theme; the shell-side colors (starship, eza, completion
# menu) are all Dracula too, so they match.
theme = Dracula

# Nerd font so starship/eza glyphs render.
font-family = "JetBrainsMono Nerd Font"

# Dracula purple (#bd93f9) for the focused cursor; the unfocused
# cursor follows the theme.
cursor-color = #bd93f9

## --- Window
# Server-side window decorations (title bar drawn by the terminal,
# not the client).
window-decoration = server

## --- Splits
# New split and vim-style split navigation (h/j/k/l).
keybind = super+enter=new_split
keybind = control+super+h=goto_split:left
keybind = control+super+j=goto_split:down
keybind = control+super+k=goto_split:up
keybind = control+super+l=goto_split:right
keybind = control+super+f=toggle_split_zoom
keybind = control+super+==equalize_splits
