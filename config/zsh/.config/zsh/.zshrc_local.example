# ============================================================================
# .zshrc_local.example — TEMPLATE for .zshrc_local.
#
# `make install` copies this to .zshrc_local (only if the latter does not
# exist yet). Edit .zshrc_local freely — it is gitignored and never
# overwritten. Keep machine-specific stuff here; shared stuff belongs in
# the other *.zsh files.
# ============================================================================

## --- Personal aliases
# alias gr="git rebase -i"
# alias reload="source ~/.zshrc && echo reloaded"

## --- Personal functions
# example() {
#     echo "hello from $USER on $(hostname)"
# }

## --- Personal bindings
# bindkey '^o' autosuggest-execute
